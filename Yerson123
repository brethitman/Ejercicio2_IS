import java.util.Scanner;

public class DivisionApp {

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        double numerador;
        double denominador;

        System.out.println("=== Operación de División ===");

        System.out.print("Ingrese el numerador: ");
        if (scanner.hasNextDouble()) {
            numerador = scanner.nextDouble();
        } else {
            System.out.println("Error: Entrada no válida para el numerador.");
            return;
        }

        System.out.print("Ingrese el denominador: ");
        if (scanner.hasNextDouble()) {
            denominador = scanner.nextDouble();
        } else {
            System.out.println("Error: Entrada no válida para el denominador.");
            return;
        }

        if (denominador == 0) {
            System.out.println("Error: No se puede dividir por cero.");
        } else {
            double resultado = numerador / denominador;
            System.out.println("El resultado de la división es: " + resultado);
        }

        scanner.close();
    }
}
